# eBiblio MCP server — copy to .env and fill in (never commit .env).
#
# Credentials: your eBiblio library account (e-mail + password).
EBIBLIO_USERNAME=
EBIBLIO_PASSWORD=
# Platform-specific aliases are also accepted:
# ANDALUCIA_EBIBLIO_USERNAME=
# ANDALUCIA_EBIBLIO_PASSWORD=

# Deployment to talk to (any eBiblio instance works).
EBIBLIO_BASE_URL=https://andalucia.ebiblio.es

# Where downloads, the ADEPT device keys and exported books are written.
EBIBLIO_DATA_DIR=/data

# Optional overrides.
EBIBLIO_TIMEOUT=30
EBIBLIO_LOG_LEVEL=INFO
# EBIBLIO_LIBGOUROU_BIN_DIR=/usr/local/bin
# EBIBLIO_EBOOK_CONVERT=/usr/bin/ebook-convert
